//// [tests/cases/compiler/stableModifierInOperator.ts] ////

=== stableModifierInOperator.ts ===
type Signal<T> = stable () => T;
>Signal : Signal<T>

interface Cat {
    kind: "cat";
>kind : "cat"

    meow(): void;
>meow : () => void
}

interface Dog {
    kind: "dog";
>kind : "dog"

    bark(): void;
>bark : () => void
}

declare const animal: Signal<Cat | Dog>;
>animal : Signal<Cat | Dog>

// Discriminant narrowing with stable
if (animal().kind === "cat") {
>animal().kind === "cat" : boolean
>animal().kind : "cat" | "dog"
>animal() : Cat | Dog
>animal : Signal<Cat | Dog>
>kind : "cat" | "dog"
>"cat" : "cat"

    const cat: Cat = animal();
>cat : Cat
>animal() : Cat
>animal : Signal<Cat | Dog>

    cat.meow();
>cat.meow() : void
>cat.meow : () => void
>cat : Cat
>meow : () => void
}

// 'in' operator narrowing with stable
if ("meow" in animal()) {
>"meow" in animal() : boolean
>"meow" : "meow"
>animal() : Cat | Dog
>animal : Signal<Cat | Dog>

    const cat: Cat = animal();
>cat : Cat
>animal() : Cat
>animal : Signal<Cat | Dog>

    cat.meow();
>cat.meow() : void
>cat.meow : () => void
>cat : Cat
>meow : () => void
}

if ("bark" in animal()) {
>"bark" in animal() : boolean
>"bark" : "bark"
>animal() : Cat | Dog
>animal : Signal<Cat | Dog>

    const dog: Dog = animal();
>dog : Dog
>animal() : Dog
>animal : Signal<Cat | Dog>

    dog.bark();
>dog.bark() : void
>dog.bark : () => void
>dog : Dog
>bark : () => void
}

// typeof narrowing with stable
declare const value: Signal<string | number>;
>value : Signal<string | number>

if (typeof value() === "string") {
>typeof value() === "string" : boolean
>typeof value() : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>value() : string | number
>value : Signal<string | number>
>"string" : "string"

    const str: string = value();
>str : string
>value() : string
>value : Signal<string | number>
}

if (typeof value() === "number") {
>typeof value() === "number" : boolean
>typeof value() : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>value() : string | number
>value : Signal<string | number>
>"number" : "number"

    const num: number = value();
>num : number
>value() : number
>value : Signal<string | number>
}

// instanceof narrowing with stable
declare const instance: Signal<Date | RegExp>;
>instance : Signal<Date | RegExp>

if (instance() instanceof Date) {
>instance() instanceof Date : boolean
>instance() : Date | RegExp
>instance : Signal<Date | RegExp>
>Date : DateConstructor

    const d: Date = instance();
>d : Date
>instance() : Date
>instance : Signal<Date | RegExp>
}

