//// [tests/cases/compiler/stableModifierLinkedPredicates.ts] ////

=== stableModifierLinkedPredicates.ts ===
// --- Section 1: Basic linked predicate ---
interface Resource<T> {
    value: stable () => T;
>value : stable () => T

    hasValue(): this.value() is Exclude<T, undefined>;
>hasValue : () => this.value() is Exclude<T, undefined>
}

declare const r: Resource<string | undefined>;
>r : Resource<string | undefined>

if (r.hasValue()) {
>r.hasValue() : boolean
>r.hasValue : () => this.value() is string
>r : Resource<string | undefined>
>hasValue : () => this.value() is string

    const s: string = r.value();  // narrowed to string
>s : string
>r.value() : string | undefined
>r.value : stable () => string | undefined
>r : Resource<string | undefined>
>value : stable () => string | undefined
}
const v: string | undefined = r.value();  // outside guard, full type
>v : string | undefined
>r.value() : string | undefined
>r.value : stable () => string | undefined
>r : Resource<string | undefined>
>value : stable () => string | undefined

// --- Section 2: Multiple guards on same target ---
interface TypedReader {
    read: stable () => number | string | boolean;
>read : stable () => string | number | boolean

    isNumber(): this.read() is number;
>isNumber : () => this.read() is number

    isString(): this.read() is string;
>isString : () => this.read() is string
}

declare const reader: TypedReader;
>reader : TypedReader

if (reader.isNumber()) {
>reader.isNumber() : boolean
>reader.isNumber : () => this.read() is number
>reader : TypedReader
>isNumber : () => this.read() is number

    const n: number = reader.read();  // narrowed to number
>n : number
>reader.read() : string | number | boolean
>reader.read : stable () => string | number | boolean
>reader : TypedReader
>read : stable () => string | number | boolean
}
if (reader.isString()) {
>reader.isString() : boolean
>reader.isString : () => this.read() is string
>reader : TypedReader
>isString : () => this.read() is string

    const s: string = reader.read();  // narrowed to string
>s : string
>reader.read() : string | number | boolean
>reader.read : stable () => string | number | boolean
>reader : TypedReader
>read : stable () => string | number | boolean
}

// --- Section 3: Guard + mutator invalidation ---
interface WritableOption<T> {
    get: stable () => T | undefined;
>get : stable () => T | undefined

    isDefined(): this.get() is T;
>isDefined : () => this.get() is T

    set: mutator (v: T | undefined) => void invalidates get;
>set : mutator (v: T | undefined) => void
>v : T | undefined
}

declare const opt: WritableOption<number>;
>opt : WritableOption<number>

if (opt.isDefined()) {
>opt.isDefined() : boolean
>opt.isDefined : () => this.get() is number
>opt : WritableOption<number>
>isDefined : () => this.get() is number

    const n1: number = opt.get();  // narrowed by linked predicate
>n1 : number
>opt.get() : number | undefined
>opt.get : stable () => number | undefined
>opt : WritableOption<number>
>get : stable () => number | undefined

    opt.set(undefined);
>opt.set(undefined) : void
>opt.set : mutator (v: number | undefined) => void
>opt : WritableOption<number>
>set : mutator (v: number | undefined) => void
>undefined : undefined

    const n2: number | undefined = opt.get();  // back to full type after mutator
>n2 : number | undefined
>opt.get() : number | undefined
>opt.get : stable () => number | undefined
>opt : WritableOption<number>
>get : stable () => number | undefined
}

// --- Section 4: Different receivers (no cross-narrowing) ---
declare const r1: Resource<string | undefined>;
>r1 : Resource<string | undefined>

declare const r2: Resource<string | undefined>;
>r2 : Resource<string | undefined>

if (r1.hasValue()) {
>r1.hasValue() : boolean
>r1.hasValue : () => this.value() is string
>r1 : Resource<string | undefined>
>hasValue : () => this.value() is string

    const s1: string = r1.value();  // narrowed
>s1 : string
>r1.value() : string | undefined
>r1.value : stable () => string | undefined
>r1 : Resource<string | undefined>
>value : stable () => string | undefined

    const s2: string | undefined = r2.value();  // NOT narrowed - different receiver
>s2 : string | undefined
>r2.value() : string | undefined
>r2.value : stable () => string | undefined
>r2 : Resource<string | undefined>
>value : stable () => string | undefined
}

// --- Section 5: Guard + uncertainty boundary ---
declare const r3: Resource<string | undefined>;
>r3 : Resource<string | undefined>

declare function unknownCall(): void;
>unknownCall : () => void

if (r3.hasValue()) {
>r3.hasValue() : boolean
>r3.hasValue : () => this.value() is string
>r3 : Resource<string | undefined>
>hasValue : () => this.value() is string

    const before: string = r3.value();  // narrowed
>before : string
>r3.value() : string | undefined
>r3.value : stable () => string | undefined
>r3 : Resource<string | undefined>
>value : stable () => string | undefined

    unknownCall();
>unknownCall() : void
>unknownCall : () => void

    const after: string | undefined = r3.value();  // narrowing lost
>after : string | undefined
>r3.value() : string | undefined
>r3.value : stable () => string | undefined
>r3 : Resource<string | undefined>
>value : stable () => string | undefined
}

// --- Section 6: Optional container pattern ---
interface Maybe<T> {
    get: stable () => T | undefined;
>get : stable () => T | undefined

    isDefined(): this.get() is T;
>isDefined : () => this.get() is T

    isEmpty(): this.get() is undefined;
>isEmpty : () => this.get() is undefined
}

declare const maybe: Maybe<number>;
>maybe : Maybe<number>

if (maybe.isDefined()) {
>maybe.isDefined() : boolean
>maybe.isDefined : () => this.get() is number
>maybe : Maybe<number>
>isDefined : () => this.get() is number

    const n: number = maybe.get();  // narrowed to number
>n : number
>maybe.get() : number | undefined
>maybe.get : stable () => number | undefined
>maybe : Maybe<number>
>get : stable () => number | undefined
}
if (maybe.isEmpty()) {
>maybe.isEmpty() : boolean
>maybe.isEmpty : () => this.get() is undefined
>maybe : Maybe<number>
>isEmpty : () => this.get() is undefined

    const u: undefined = maybe.get();  // narrowed to undefined
>u : undefined
>maybe.get() : number | undefined
>maybe.get : stable () => number | undefined
>maybe : Maybe<number>
>get : stable () => number | undefined
}

// --- Section 7: Guard is not stable itself (rule 2) ---
interface Container<T> {
    value: stable () => T | null;
>value : stable () => T | null

    hasValue(): this.value() is T;
>hasValue : () => this.value() is T
}

declare const c: Container<string>;
>c : Container<string>

if (c.hasValue()) {
>c.hasValue() : boolean
>c.hasValue : () => this.value() is string
>c : Container<string>
>hasValue : () => this.value() is string

    const s: string = c.value();  // narrowed
>s : string
>c.value() : string | null
>c.value : stable () => string | null
>c : Container<string>
>value : stable () => string | null
}

// --- Section 8: Negative - target not stable ---
interface BadTarget {
    value(): string | undefined;  // NOT stable (method signature, not stable function type)
>value : () => string | undefined

    hasValue(): this.value() is string;  // should error: target must be stable
>hasValue : () => this.value() is string
}

// --- Section 9: Negative - narrowed type not assignable ---
interface BadNarrowing {
    get: stable () => number | string;
>get : stable () => string | number

    check(): this.get() is boolean;  // should error: boolean not assignable to number | string
>check : () => this.get() is boolean
}

// --- Section 10: Guard method called but result not used in condition ---
declare const r4: Resource<string | undefined>;
>r4 : Resource<string | undefined>

r4.hasValue();  // called but not in a condition - no narrowing effect
>r4.hasValue() : boolean
>r4.hasValue : () => this.value() is string
>r4 : Resource<string | undefined>
>hasValue : () => this.value() is string

const v4: string | undefined = r4.value();  // full type, no narrowing
>v4 : string | undefined
>r4.value() : string | undefined
>r4.value : stable () => string | undefined
>r4 : Resource<string | undefined>
>value : stable () => string | undefined

