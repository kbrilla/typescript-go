// --- Section 3: Guard + mutator invalidation ---
interface WritableOption<T> {
>WritableOption : Symbol(WritableOption, Decl(stableModifierLinkedPredicates.ts, 25, 1))
>T : Symbol(T, Decl(stableModifierLinkedPredicates.ts, 28, 25))

    get: stable () => T | undefined;
