>opt : Symbol(opt, Decl(stableModifierLinkedPredicates.ts, 34, 13))
>get : Symbol(WritableOption.get, Decl(stableModifierLinkedPredicates.ts, 28, 29))

    opt.set(undefined);
>opt.set : Symbol(WritableOption.set, Decl(stableModifierLinkedPredicates.ts, 30, 33))
>opt : Symbol(opt, Decl(stableModifierLinkedPredicates.ts, 34, 13))
>set : Symbol(WritableOption.set, Decl(stableModifierLinkedPredicates.ts, 30, 33))
>undefined : Symbol(undefined)

    const n2: number | undefined = opt.get();  // back to full type after mutator
>n2 : Symbol(n2, Decl(stableModifierLinkedPredicates.ts, 38, 9))
>opt.get : Symbol(WritableOption.get, Decl(stableModifierLinkedPredicates.ts, 28, 29))
>opt : Symbol(opt, Decl(stableModifierLinkedPredicates.ts, 34, 13))
