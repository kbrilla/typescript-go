>T : Symbol(T, Decl(stableModifierLinkedPredicates.ts, 28, 25))

    isDefined(): this.get() is T;
>isDefined : Symbol(WritableOption.isDefined, Decl(stableModifierLinkedPredicates.ts, 29, 36))
>T : Symbol(T, Decl(stableModifierLinkedPredicates.ts, 28, 25))

    set: mutator (v: T | undefined) => void invalidates get;
>set : Symbol(WritableOption.set, Decl(stableModifierLinkedPredicates.ts, 30, 33))
>v : Symbol(v, Decl(stableModifierLinkedPredicates.ts, 31, 18))
>T : Symbol(T, Decl(stableModifierLinkedPredicates.ts, 28, 25))
}

