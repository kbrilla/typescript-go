// --- Section 8: Negative - target not stable ---
interface BadTarget {
>BadTarget : Symbol(BadTarget, Decl(stableModifierLinkedPredicates.ts, 82, 1))

    value(): string | undefined;  // NOT stable (method signature, not stable function type)
>value : Symbol(BadTarget.value, Decl(stableModifierLinkedPredicates.ts, 85, 21))

    hasValue(): this.value() is string;  // should error: target must be stable
>hasValue : Symbol(BadTarget.hasValue, Decl(stableModifierLinkedPredicates.ts, 86, 32))
}

// --- Section 9: Negative - narrowed type not assignable ---
interface BadNarrowing {
>BadNarrowing : Symbol(BadNarrowing, Decl(stableModifierLinkedPredicates.ts, 88, 1))

    get: stable () => number | string;
>get : Symbol(BadNarrowing.get, Decl(stableModifierLinkedPredicates.ts, 91, 24))

    check(): this.get() is boolean;  // should error: boolean not assignable to number | string
>check : Symbol(BadNarrowing.check, Decl(stableModifierLinkedPredicates.ts, 92, 38))
}

