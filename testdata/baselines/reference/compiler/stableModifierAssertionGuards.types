    const s: string = maybeStr(); // Should be narrowed after assertion
>s : string
>maybeStr() : string | undefined
>maybeStr : Signal<string | undefined>
}

// === Section 2: Type predicate narrowing ===
declare function isString(value: unknown): value is string;
>isString : (value: unknown) => value is string
>value : unknown

declare const unknown: Signal<string | number>;
>unknown : Signal<string | number>

if (isString(unknown())) {
>isString(unknown()) : boolean
>isString : (value: unknown) => value is string
>unknown() : string | number
