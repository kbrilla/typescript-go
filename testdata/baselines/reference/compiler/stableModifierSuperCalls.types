>before : string
>this.get() : string | undefined
>this.get : () => string | undefined
>this : this
>get : () => string | undefined

            before;
>before : string

            this.set("new");
>this.set("new") : void
>this.set : (value: string | undefined) => void
>this : this
>set : (value: string | undefined) => void
>"new" : "new"

            const after: string = this.get(); // should error — this.set() resets
>after : string
>this.get() : string | undefined
>this.get : () => string | undefined
>this : this
>get : () => string | undefined

            after;
>after : string
        }
    }
