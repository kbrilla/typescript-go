//// [tests/cases/compiler/stableModifierAdvancedLoops.ts] ////

=== stableModifierAdvancedLoops.ts ===
// Phase 3: Advanced loop patterns with stable narrowing.
// Verifies that for-in nonnull, for-of with narrowing, and loop body
// boundaries interact correctly with stable CFA.

declare const readObj: stable () => Record<string, number> | undefined;
>readObj : stable () => Record<string, number> | undefined

declare const readArr: stable () => number[] | undefined;
>readArr : stable () => number[] | undefined

declare const read: stable () => string | undefined;
>read : stable () => string | undefined

// For-in over stable read — should narrow to non-nullish.
if (readObj() !== undefined) {
>readObj() !== undefined : boolean
>readObj() : Record<string, number> | undefined
>readObj : stable () => Record<string, number> | undefined
>undefined : undefined

    for (const key in readObj()) {
>key : string
>readObj() : Record<string, number> | undefined
>readObj : stable () => Record<string, number> | undefined

        const k: string = key;
>k : string
>key : string

        k;
>k : string
    }
}

// For-of over stable read — should work with narrowed array.
if (readArr() !== undefined) {
>readArr() !== undefined : boolean
>readArr() : number[] | undefined
>readArr : stable () => number[] | undefined
>undefined : undefined

    for (const item of readArr()) {
>item : number
>readArr() : number[] | undefined
>readArr : stable () => number[] | undefined

        const n: number = item;
>n : number
>item : number

        n;
>n : number
    }
}

// For-of with destructuring from stable read.
declare const readPairs: stable () => Array<{ a: string; b: number }>;
>readPairs : stable () => { a: string; b: number; }[]
>a : string
>b : number

for (const { a, b } of readPairs()) {
>a : string
>b : number
>readPairs() : { a: string; b: number; }[]
>readPairs : stable () => { a: string; b: number; }[]

    const str: string = a;
>str : string
>a : string

    const num: number = b;
>num : number
>b : number

    str;
>str : string

    num;
>num : number
}

// While loop with stable read condition.
declare const readFlag: stable () => boolean;
>readFlag : stable () => boolean

while (readFlag()) {
>readFlag() : boolean
>readFlag : stable () => boolean

    const flag: boolean = readFlag();
>flag : boolean
>readFlag() : boolean
>readFlag : stable () => boolean

    flag;
>flag : true
}

// Do-while with stable read.
do {
    const val = read();
>val : string | undefined
>read() : string | undefined
>read : stable () => string | undefined

    val;
>val : string | undefined

} while (read() !== undefined);
>read() !== undefined : boolean
>read() : string | undefined
>read : stable () => string | undefined
>undefined : undefined

// Nested for-of with stable.
declare const readMatrix: stable () => number[][];
>readMatrix : stable () => number[][]

for (const row of readMatrix()) {
>row : number[]
>readMatrix() : number[][]
>readMatrix : stable () => number[][]

    for (const cell of row) {
>cell : number
>row : number[]

        const n: number = cell;
>n : number
>cell : number

        n;
>n : number
    }
}

// For-of with narrowing check inside loop body.
if (read() !== undefined) {
>read() !== undefined : boolean
>read() : string | undefined
>read : stable () => string | undefined
>undefined : undefined

    for (const _ of [1, 2, 3]) {
>_ : number
>[1, 2, 3] : number[]
>1 : 1
>2 : 2
>3 : 3

        if (read() !== undefined) {
>read() !== undefined : boolean
>read() : string | undefined
>read : stable () => string | undefined
>undefined : undefined

            const val: string = read();
>val : string
>read() : string | undefined
>read : stable () => string | undefined

            val;
>val : string
        }
    }
}

