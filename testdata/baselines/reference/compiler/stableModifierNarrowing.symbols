// Basic stable function type narrowing
declare const value: stable () => string | undefined;
>value : Symbol(value, Decl(stableModifierNarrowing.ts, 1, 13))

if (value() !== undefined) {
>value : Symbol(value, Decl(stableModifierNarrowing.ts, 1, 13))
