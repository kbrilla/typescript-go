>"circle" : "circle"

    unknownMutate();
>unknownMutate() : void
>unknownMutate : () => void

    const getterAfterUnknown: number = getterModel.value.radius; // getter baseline: remains narrowed in this sweep shape
>getterAfterUnknown : number
>getterModel.value.radius : number
>getterModel.value : { kind: "circle"; radius: number; }
>getterModel : { readonly value: Shape; }
>value : { kind: "circle"; radius: number; }
>radius : number

