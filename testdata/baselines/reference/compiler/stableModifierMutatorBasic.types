};

if (storeA.read() !== undefined && storeB.read() !== undefined) {
>storeA.read() !== undefined && storeB.read() !== undefined : boolean
>storeA.read() !== undefined : boolean
>storeA.read() : string | undefined
>storeA.read : () => string | undefined
>storeA : { read: () => string | undefined; reset: () => void; }
>read : () => string | undefined
>undefined : undefined
>storeB.read() !== undefined : boolean
