>read : () => string | undefined
>undefined : undefined

    storeA.reset();
>storeA.reset() : void
>storeA.reset : () => void
>storeA : { read: () => string | undefined; reset: () => void; }
>reset : () => void

    const aAfterReset: string = storeA.read(); // should error — same receiver mutator
>aAfterReset : string
>storeA.read() : string | undefined
>storeA.read : () => string | undefined
>storeA : { read: () => string | undefined; reset: () => void; }
>read : () => string | undefined

    const bAfterReset: string = storeB.read(); // OK — different receiver, unaffected
>bAfterReset : string
>storeB.read() : string | undefined
>storeB.read : () => string | undefined
