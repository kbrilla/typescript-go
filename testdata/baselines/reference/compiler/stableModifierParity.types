// Callable hybrid parity: same callable symbol used as getter and setter-style write.
// Known Phase 1 limitation: `stable` on call signatures in interfaces is not supported.
// The parser interprets `stable` as a method name, not a modifier on the call signature.
// Only standalone function types (`stable () => T`) are supported in Phase 1.
// See Edge Case 4 in docs/stable-modifier-research.md.
interface HybridSignal {
    stable (): string | undefined;
>stable : () => string | undefined

    (v: string | undefined): void;
>v : string | undefined
}

declare const hybrid: HybridSignal;
>hybrid : HybridSignal

// Because `stable` is parsed as a method name (not a call signature modifier),
// overload resolution only sees the setter `(v)` overload for zero-arg calls.
// These errors are expected in Phase 1.
if (hybrid() !== undefined) {
>hybrid() !== undefined : boolean
>hybrid() : void
>hybrid : HybridSignal
>undefined : undefined

    hybrid("next");
>hybrid("next") : void
>hybrid : HybridSignal
>"next" : "next"

    const afterHybridSetCall: string = hybrid(); // should error
>afterHybridSetCall : string
>hybrid() : void
>hybrid : HybridSignal

    afterHybridSetCall;
>afterHybridSetCall : string
}

// Callable hybrid direct undefined write should also invalidate prior narrowing.
// Same Phase 1 limitation applies here.
if (hybrid() !== undefined) {
>hybrid() !== undefined : boolean
>hybrid() : void
>hybrid : HybridSignal
>undefined : undefined

    hybrid(undefined);
>hybrid(undefined) : void
>hybrid : HybridSignal
>undefined : undefined

    const afterHybridUndefinedWrite: string = hybrid(); // should error
>afterHybridUndefinedWrite : string
>hybrid() : void
>hybrid : HybridSignal

    afterHybridUndefinedWrite;
>afterHybridUndefinedWrite : string
}

