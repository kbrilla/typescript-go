if (maybe() !== undefined) {
>maybe() !== undefined : boolean
>maybe() : string | undefined
>maybe : () => string | undefined
>undefined : undefined

    const alsoDefinite = maybe()!; // should be string (already narrowed)
>alsoDefinite : string
>maybe()! : string
>maybe() : string | undefined
>maybe : () => string | undefined

    alsoDefinite;
