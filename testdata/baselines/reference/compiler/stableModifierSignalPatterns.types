// -----------------------------------------------------------------------------
// Section 4: Non-null assertion stable()! patterns
// -----------------------------------------------------------------------------

declare const maybe: stable () => string | undefined;
>maybe : () => string | undefined

const definite = maybe()!; // should be string
>definite : string
>maybe()! : string
>maybe() : string | undefined
