>length : number

declare const maybeNum: stable () => number | null;
>maybeNum : () => number | null

const definiteNum = maybeNum()!; // should be number
>definiteNum : number
>maybeNum()! : number
>maybeNum() : number | null
>maybeNum : () => number | null

