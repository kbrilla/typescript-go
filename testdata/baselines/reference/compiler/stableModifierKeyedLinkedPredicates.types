>undefined : undefined

    const e: number = map.get(key);       // narrowed (same variable ref)
>e : number
>map.get(key) : number | undefined
>map.get : stable (key: string) => number | undefined
>map : TypedMap<string, number>
>get : stable (key: string) => number | undefined
>key : string
}

// === 3. Independent keys narrowed simultaneously ===
if (map.get("a") !== undefined && map.get("b") !== undefined) {
>map.get("a") !== undefined && map.get("b") !== undefined : boolean
>map.get("a") !== undefined : boolean
>map.get("a") : number | undefined
>map.get : stable (key: string) => number | undefined
>map : TypedMap<string, number>
>get : stable (key: string) => number | undefined
>"a" : "a"
>undefined : undefined
>map.get("b") !== undefined : boolean
>map.get("b") : number | undefined
>map.get : stable (key: string) => number | undefined
>map : TypedMap<string, number>
>get : stable (key: string) => number | undefined
>"b" : "b"
>undefined : undefined

    const f: number = map.get("a");       // narrowed
>f : number
>map.get("a") : number | undefined
>map.get : stable (key: string) => number | undefined
>map : TypedMap<string, number>
>get : stable (key: string) => number | undefined
>"a" : "a"

    const g: number = map.get("b");       // narrowed
>g : number
>map.get("b") : number | undefined
>map.get : stable (key: string) => number | undefined
