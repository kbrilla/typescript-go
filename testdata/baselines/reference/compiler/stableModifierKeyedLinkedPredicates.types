// === 5. Function type syntax with keyed stable ===
interface FuncMap<K, V> {
    get: stable[key] (key: K) => V | undefined;
>get : stable (key: K) => V | undefined
>key : K

    set: mutator (key: K, value: V) => void invalidates get[key];
>set : mutator (key: K, value: V) => void
>key : K
>value : V
}

declare const fmap: FuncMap<string, number>;
>fmap : FuncMap<string, number>

if (fmap.get("z") !== undefined) {
>fmap.get("z") !== undefined : boolean
>fmap.get("z") : number | undefined
>fmap.get : stable (key: string) => number | undefined
>fmap : FuncMap<string, number>
>get : stable (key: string) => number | undefined
>"z" : "z"
>undefined : undefined

    const j: number = fmap.get("z");      // narrowed
>j : number
>fmap.get("z") : number | undefined
>fmap.get : stable (key: string) => number | undefined
>fmap : FuncMap<string, number>
>get : stable (key: string) => number | undefined
>"z" : "z"

    fmap.set("w", 5);                     // different key
>fmap.set("w", 5) : void
>fmap.set : mutator (key: string, value: number) => void
>fmap : FuncMap<string, number>
>set : mutator (key: string, value: number) => void
>"w" : "w"
>5 : 5

    const k: number = fmap.get("z");      // still narrowed
>k : number
>fmap.get("z") : number | undefined
>fmap.get : stable (key: string) => number | undefined
>fmap : FuncMap<string, number>
>get : stable (key: string) => number | undefined
>"z" : "z"
}

// === 6. Multi-stable per-key invalidation — explicit control ===
interface MultiStore {
    stable[key] getA(key: string): number | undefined;
>getA : stable (key: string) => number | undefined
>key : string
>key : any

    stable[key] getB(key: string): number | undefined;
>getB : stable (key: string) => number | undefined
>key : string
>key : any

    mutator setA(key: string, value: number): void invalidates getA[key];
>setA : mutator (key: string, value: number) => void
>key : string
>value : number
>getA : any

    mutator setAll(key: string): void invalidates getA[key], getB[key];
>setAll : mutator (key: string) => void
>key : string
>getA : any
>getB : any

    mutator reset(): void invalidates getA, getB;  // unkeyed → all keys
>reset : mutator () => void
>getA : any
>getB : any
}

declare const ms: MultiStore;
>ms : MultiStore

if (ms.getA("x") !== undefined && ms.getB("x") !== undefined && ms.getA("y") !== undefined) {
>ms.getA("x") !== undefined && ms.getB("x") !== undefined && ms.getA("y") !== undefined : boolean
>ms.getA("x") !== undefined && ms.getB("x") !== undefined : boolean
>ms.getA("x") !== undefined : boolean
>ms.getA("x") : number | undefined
>ms.getA : stable (key: string) => number | undefined
>ms : MultiStore
>getA : stable (key: string) => number | undefined
>"x" : "x"
>undefined : undefined
>ms.getB("x") !== undefined : boolean
>ms.getB("x") : number | undefined
>ms.getB : stable (key: string) => number | undefined
>ms : MultiStore
>getB : stable (key: string) => number | undefined
>"x" : "x"
>undefined : undefined
>ms.getA("y") !== undefined : boolean
>ms.getA("y") : number | undefined
>ms.getA : stable (key: string) => number | undefined
>ms : MultiStore
>getA : stable (key: string) => number | undefined
>"y" : "y"
>undefined : undefined

    ms.setA("x", 42);          // only invalidates getA("x"), NOT getB("x") or getA("y")
>ms.setA("x", 42) : void
>ms.setA : mutator (key: string, value: number) => void
>ms : MultiStore
>setA : mutator (key: string, value: number) => void
>"x" : "x"
>42 : 42

    const msb: number = ms.getB("x");    // still narrowed
>msb : number
>ms.getB("x") : number | undefined
>ms.getB : stable (key: string) => number | undefined
>ms : MultiStore
>getB : stable (key: string) => number | undefined
>"x" : "x"

    const msa: number = ms.getA("y");    // still narrowed (different key)
>msa : number
>ms.getA("y") : number | undefined
>ms.getA : stable (key: string) => number | undefined
>ms : MultiStore
>getA : stable (key: string) => number | undefined
>"y" : "y"

    ms.setAll("y");            // invalidates getA("y") AND getB("y")
>ms.setAll("y") : void
>ms.setAll : mutator (key: string) => void
>ms : MultiStore
>setAll : mutator (key: string) => void
>"y" : "y"

    const msa2 = ms.getA("x");           // number | undefined — already invalidated by setA("x") above
>msa2 : number | undefined
>ms.getA("x") : number | undefined
>ms.getA : stable (key: string) => number | undefined
>ms : MultiStore
>getA : stable (key: string) => number | undefined
>"x" : "x"

    ms.reset();                // invalidates ALL keys of both getA and getB
>ms.reset() : void
>ms.reset : mutator () => void
>ms : MultiStore
>reset : mutator () => void

    const msa3 = ms.getA("x");           // number | undefined — should error if assigned to number
>msa3 : number | undefined
>ms.getA("x") : number | undefined
>ms.getA : stable (key: string) => number | undefined
>ms : MultiStore
>getA : stable (key: string) => number | undefined
>"x" : "x"
}

