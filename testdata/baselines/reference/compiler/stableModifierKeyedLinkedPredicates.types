>"b" : "b"

    map.set("a", 10);                     // only invalidates get("a")
>map.set("a", 10) : void
>map.set : mutator (key: string, value: number) => void
>map : TypedMap<string, number>
>set : mutator (key: string, value: number) => void
>"a" : "a"
>10 : 10

    const h: number = map.get("b");       // still narrowed
>h : number
>map.get("b") : number | undefined
>map.get : stable (key: string) => number | undefined
>map : TypedMap<string, number>
>get : stable (key: string) => number | undefined
>"b" : "b"
}

// === 4. delete per-key invalidation ===
if (map.get("x") !== undefined && map.get("y") !== undefined) {
>map.get("x") !== undefined && map.get("y") !== undefined : boolean
>map.get("x") !== undefined : boolean
>map.get("x") : number | undefined
>map.get : stable (key: string) => number | undefined
>map : TypedMap<string, number>
>get : stable (key: string) => number | undefined
>"x" : "x"
>undefined : undefined
>map.get("y") !== undefined : boolean
