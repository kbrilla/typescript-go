>store.clear : () => void
>store : { read: () => string | undefined; clear(): void; reset(v: string): void; }
>clear : () => void

    const s: string = store.read(); // Transparent - getter parity: method calls don't invalidate narrowing
>s : string
>store.read() : string | undefined
>store.read : () => string | undefined
>store : { read: () => string | undefined; clear(): void; reset(v: string): void; }
>read : () => string | undefined
}

if (store.read() !== undefined) {
>store.read() !== undefined : boolean
>store.read() : string | undefined
>store.read : () => string | undefined
>store : { read: () => string | undefined; clear(): void; reset(v: string): void; }
>read : () => string | undefined
