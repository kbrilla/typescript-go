>getState : stable () => string | undefined
>undefined : undefined

    const s: string = getState(); // narrowed
>s : string
>getState() : string
>getState : stable () => string | undefined

    setState(undefined); // mutator — should invalidate getState() narrowing
>setState(undefined) : void
>setState : mutator (val: string | undefined) => void
>undefined : undefined

    const s2: string | undefined = getState(); // back to string | undefined
>s2 : string | undefined
>getState() : string
>getState : stable () => string | undefined
}

